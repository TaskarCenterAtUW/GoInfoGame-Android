<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Light red tint, so a photo marked for removal reads as visibly different from a
         normal attached/synced photo card at a glance. -->
    <solid android:color="#FCEEEE" />

    <stroke
        android:width="1dp"
        android:color="@color/traffic_red" />
    <corners android:radius="8dp"/>
</shape>

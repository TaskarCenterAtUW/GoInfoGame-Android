<?xml version="1.0" encoding="utf-8"?>
<!-- ic_pin with a soft ground-shadow ellipse at the pin's tip (bottom center), same radial
     gradient idiom as location_shadow.xml. The ellipse is centered on the bottom edge via the
     negative inset; the half below gets clipped, leaving a half-ellipse under the tip. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="16dp"
        android:height="8dp"
        android:gravity="center_horizontal|bottom">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="8dp"
                android:startColor="#000000"
                android:centerColor="#00000000"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- direct drawable reference (not <bitmap>): ic_pin_new is a vector, which <bitmap> can't inflate -->
    <item android:drawable="@drawable/ic_pin_new" />
</layer-list>

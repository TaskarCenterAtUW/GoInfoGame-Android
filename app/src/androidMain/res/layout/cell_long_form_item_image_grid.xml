<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="TextView" />

    <ImageView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toTopOf="@id/description"
        android:id="@+id/imageView"
        android:importantForAccessibility="no"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.35"
        android:background="@drawable/black_image_border"
        android:layout_height="150dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:adjustViewBounds="true"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintHorizontal_bias="0.0" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/imageView"
        app:layout_constraintEnd_toEndOf="@id/imageView"
        app:layout_constraintTop_toTopOf="@id/imageView"
        app:layout_constraintBottom_toBottomOf="@id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        tools:text="TextView" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/description" />

    <TextView
        android:id="@+id/choice_follow_up"
        android:layout_margin="16dp"
        app:drawableTopCompat="@drawable/ic_camera_outlined"
        app:drawableTint="@color/button_white"
        android:padding="8dp"
        android:textColor="@color/button_white"
        android:textAlignment="center"
        android:textSize="16sp"
        android:visibility="gone"
        tools:text="Please take a picture of the narrowest place on this sidewalk"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/list"
        android:background="@drawable/gradient_primary_accent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Shown in choice_follow_up's place once a photo is attached (locally pending upload) or
         was already attached from a previous visit - see LongFormAdapter.updateChoiceFollowUp. -->
    <RelativeLayout
        android:id="@+id/photo_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:background="@drawable/black_image_border"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/list">

        <ImageView
            android:id="@+id/photo_thumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:background="@drawable/black_image_border"
            android:importantForAccessibility="no" />

        <ProgressBar
            android:id="@+id/photo_thumb_progress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:visibility="gone"
            android:layout_alignTop="@id/photo_thumb"
            android:layout_alignBottom="@id/photo_thumb"
            android:layout_alignStart="@id/photo_thumb"
            android:layout_alignEnd="@id/photo_thumb"
            android:layout_margin="18dp" />

        <ImageView
            android:id="@+id/photo_delete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="0dp"
            app:srcCompat="@drawable/ic_close_24dp"
            android:scaleType="center"
            app:tint="#fff"
            android:background="#9333"
            android:layout_alignTop="@id/photo_thumb"
            android:layout_alignEnd="@id/photo_thumb"
            android:contentDescription="Remove photo" />

        <!-- The camera icon (photo_retake) is always shown alongside whichever badge/button
             applies - capturing a new photo always supersedes whatever's there, whether it's a
             not-yet-uploaded capture, an already-synced photo, or one already marked for removal
             (photo_undo) - so there's never a dead end where replacing needs an UNDO first. -->
        <LinearLayout
            android:id="@+id/photo_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">

            <ImageView
                android:id="@+id/photo_retake"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:background="@drawable/background_white_circle"
                app:srcCompat="@drawable/ic_camera_outlined"
                app:tint="@color/primary"
                android:contentDescription="Retake photo" />

            <TextView
                android:id="@+id/photo_undo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/pill_button_primary"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="UNDO"
                android:textColor="@color/button_white"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/photo_thumb"
            android:layout_toStartOf="@id/photo_actions"
            android:layout_marginStart="12dp"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/photo_title"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Photo attached" />

            <TextView
                android:id="@+id/photo_subtitle"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Uploads when you submit" />
        </LinearLayout>

    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

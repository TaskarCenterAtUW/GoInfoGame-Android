# Copy this file to secrets.properties (git-ignored) and fill in the values.
# Alternatively, each value can be supplied via an environment variable of the
# same name as noted below (the env var takes precedence).

# KartaView (api.openstreetcam.org) access token used for photo uploads.
# Obtain one from the KartaView account that owns the app's photo sequences.
# Env var alternative: KARTAVIEW_ACCESS_TOKEN
kartaViewAccessToken=

# Bearer token (JWT) for photo uploads to the dev Panoramax instance (DEV environment).
# Generate one for the upload account with POST /api/users/me/tokens on the instance.
# Env var alternative: PANORAMAX_DEV_ACCESS_TOKEN
panoramaxDevAccessToken=
# Same for the stage Panoramax instance (STAGE environment).
# Env var alternative: PANORAMAX_STAGE_ACCESS_TOKEN
panoramaxStageAccessToken=
# Same for the prod Panoramax instance (PROD environment). If unset, panoramaxDevAccessToken is used:
# PROD uploads to the dev instance until the prod one exists.
# Env var alternative: PANORAMAX_PROD_ACCESS_TOKEN
panoramaxProdAccessToken=
